{
  "name": "nimi",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "scripts": {
    "dev": "bun --bun vite dev --port 3000",
    "generate-routes": "bun --bun tsr generate",
    "build": "bun --bun vite build",
    "start": "bun --bun .output/server/index.mjs",
    "preview": "bun --bun vite preview",
    "lint": "bun --bun eslint",
    "format": "bun --bun prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "check": "bun --bun prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "typecheck": "bun --bun tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@tailwindcss/vite": "^4",
    "@tanstack/react-devtools": "latest",
    "@tanstack/react-router": "latest",
    "@tanstack/react-router-devtools": "latest",
    "@tanstack/react-start": "latest",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "lucide-react": "^1.52.0",
    "nitro": "^3.0.260903-beta",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "shadcn": "^4.21.1",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tanstack/devtools-vite": "latest",
    "@tanstack/eslint-config": "latest",
    "@tanstack/router-cli": "^1.167.39",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6",
    "eslint": "^10",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "^6.0.2",
    "vite": "^8"
  }
}
